.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 70;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12px;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  background: rgba(5, 13, 8, 0.64);
}

.modal {
  width: min(480px, 100%);
  max-height: calc(100vh - 24px);
  max-height: calc(100dvh - 24px);
  overflow-x: hidden;
  overflow-y: auto;
  overscroll-behavior-y: contain;
  -webkit-overflow-scrolling: touch;
  flex-shrink: 0;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 24px;
  box-shadow: 0 20px 70px rgba(0, 0, 0, 0.25);
}

.modal.wide {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-scroll-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior-y: contain;
  padding-right: 4px;
  margin-right: -4px;
}

.modal .summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 18px;
  padding-top: 14px;
  border-top: 1px solid var(--line);
  background: var(--panel);
  flex-shrink: 0;
}

@media (max-width: 560px) {
  .modal-backdrop {
    align-items: stretch;
    padding: 12px 10px 18px;
    overflow: hidden;
  }

  .modal,
  .modal.wide {
    width: 100%;
    height: calc(100dvh - 24px);
    max-height: calc(100dvh - 24px);
    padding: 18px 18px 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .modal .summary-row {
    position: relative;
    bottom: auto;
    z-index: 2;
    margin: 16px -18px 0;
    padding: 14px 18px calc(18px + env(safe-area-inset-bottom));
    background: var(--panel);
    border-top: 1px solid var(--line);
    box-shadow: 0 -8px 18px rgba(0, 0, 0, 0.04);
    flex-shrink: 0;
  }

  .modal .summary-row > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .modal-scroll-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding-bottom: 8px;
  }
}

/* ========== Debt Detail – sticky footer ONLY on mobile (above MobileNav) ========== */
@media (max-width: 560px) {
  .debt-detail-modal {
    display: flex;
    flex-direction: column;
    width: 100%;
    /* Leave room for the fixed mobile nav and safe-area inset */
    height: calc(100dvh - 24px - 86px);
    max-height: calc(100dvh - 24px - 86px);
    min-height: 0;
    overflow: hidden;
    overscroll-behavior-y: contain;
    padding: 16px 16px 0;
  }

  .debt-detail-modal .modal-header {
    flex-shrink: 0;
    margin-bottom: 12px;
  }

  .debt-detail-modal .debt-detail-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-y: contain;
    padding-bottom: 16px;
    margin-right: -4px;
    padding-right: 4px;
  }

  .debt-detail-modal > .summary-row {
    position: sticky;
    bottom: 0;
    z-index: 2;
    flex-shrink: 0;
    margin: 12px -16px 0;
    padding: 14px 16px calc(12px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
    background: var(--panel);
    box-shadow: 0 -8px 18px rgba(0, 0, 0, 0.04);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
}
