    setReceipts((receipts) => [savedReceipt, ...receipts])

    setModal(null)

    notify(
  `New stock recorded: ${savedReceipt.name} (${savedReceipt.quantity} units)`,
  `Incoming stock recorded. Model: ${savedReceipt.model}. Invoice: ${savedReceipt.invoice}. Quantity: ${savedReceipt.quantity} units. Received: ${savedReceipt.date}.`,
  true,
  {
    type: 'stock',
    product: savedReceipt.name,
    quantity: savedReceipt.quantity,
  }
)
  } catch (error) {
    console.error('Failed to record stock receipt:', error)
    setToast('Failed to record stock receipt')
  }
}

  const sectionHeading = section === 'New Stocks' ? 'Stock' : section === 'Store' ? 'Store' : section

  return (
    <div className={dark ? 'app-shell dark' : 'app-shell'}>
      <Sidebar section={section} sidebar={sidebar} settings={settings} onGo={go} onClose={() => setSidebar(false)} />

      <main className="main-content">
        <Topbar
          section={section}
          dark={dark}
          notifications={notifications}
          menuOpen={menuOpen}
          activities={activities}
          onToggleTheme={() => setDark(!dark)}
          onToggleNotifications={() => setNotifications(!notifications)}
          onOpenInbox={openInbox}
          onOpenSection={go}
          onToggleMenu={() => setMenuOpen(!menuOpen)}
          onSignOut={signOut}
          onViewNotification={viewNotification}
        />

        <div className="page-wrap">
          {section !== 'POS' && <div className="page-heading">
            <div>
              <div className="eyebrow">{section === 'Overview' ? 'Good morning, Alex' : 'Workspace'}</div>
              <h1>{sectionHeading}</h1>
              <p>
                {section === 'Overview' ? 'A clear view of your market, stock, and customer accounts.' : section === 'Debt' ? 'Stay on top of outstanding customer balances.' : section === 'Paid' ? 'A record of completed customer payments.' : section === 'Settings' ? 'Manage workspace preferences and access.' : section === 'Team members' ? 'People with access to this workspace.' : section === 'New Stocks' ? 'Review incoming inventory and recent receipts.' : section === 'Store' ? 'Receive, check, and record deliveries at your main store.' : section === 'Transfers' ? 'Record goods dispatched from the main store to a branch.' : 'Keep an eye on your products and stock levels.'}
              </p>
            </div>
            {!['Overview', 'Paid', 'Settings', 'Team members', 'Inbox', 'Store', 'Transfers'].includes(section) && (
              <button className="primary-button" onClick={() => setModal(section === 'Debt' ? 'debt' : section === 'New Stocks' ? 'receipt' : 'product')}>
                <Plus />
                {section === 'Debt' ? 'Add debt' : section === 'New Stocks' ? 'Record stock' : 'Add product'}
              </button>
            )}
          </div>}

          {section === 'Overview' && <OverviewSection outstanding={outstanding} salesMinor={overviewSalesMinor} currency={settings.currency} onGo={go} />}

          <PosCart active={section === 'POS'} products={products} productsLoading={productsLoading} productsError={productsError} currency={settings.currency} workspace={settings.workspace} onRefreshProducts={refreshPosProducts} onOpen={() => go('POS')} />

          {section === 'Stocks' && (
            <>
              <div className="stat-grid">
                <Stat icon={<Package />} label="Total products" value={products.length.toLocaleString()} change="+12.5%" positive />
             <Stat
               icon={<TrendingUpIcon />}
               label="Total stock value"
               value={money(
               products.reduce((a, p) => a + p.stock * p.price, 0),
               settings.currency
                )}
               change="+8.2%"
               positive
                />               
          <Stat icon={<CircleAlert />} label="Low stock items" value={products.filter((p) => p.status === 'Low stock').length.toString()} change="Needs attention" />
                <Stat icon={<WalletCards />} label="Out of stock" value={products.filter((p) => p.stock === 0).length.toString()} change="-2 this week" positive />
              </div>
              <section className="panel mb-20 ">
                <Toolbar query={query} setQuery={setQuery} statusFilter={statusFilter} setStatusFilter={setStatusFilter} options={['All', 'In stock', 'Low stock', 'Out of stock']} />
                <ProductTable
                  products={filteredProducts}
                  onNotify={notify}

                  lowStockThreshold={Math.max(0, Number(settings.lowStockThreshold) || 0)}
                  onSaveEdit={async (id, updates) => {
                    const currentProduct = products.find((p) => p.id === id)

                    if (!currentProduct) {
                      throw new Error('Product not found')
                    }

                    const stock = Math.max(
                      0,
                      Number(updates.stock ?? currentProduct.stock) || 0
                    )
                    const price = Math.max(
                      0,
                      Number(updates.price ?? currentProduct.price) || 0
                    )
                    const threshold = Math.max(
                      0,
                      Number(settings.lowStockThreshold) || 0
                    )

                    const status =
                      updates.status === 'Discontinued' ||
                      (updates.status !== 'Automatic' && currentProduct.status === 'Discontinued')
                        ? 'Discontinued'
                        : stock === 0
                          ? 'Out of stock'
                          : stock <= threshold
                            ? 'Low stock'
                            : 'In stock'

                    try {
                      const updatedProduct = await updateProductOnServer(id, {
                        ...updates,
                        stock,
                        price,
                        status,
                      })

                      setProducts((items) =>
                        items.map((p) => p.id === id ? updatedProduct : p)
                      )

                      if (stock !== currentProduct.stock) {
                        notify(
                          `${updatedProduct.name} stock updated`,
                          `Stock changed from ${currentProduct.stock} to ${stock} units. Status: ${status}.`,
                          true,
                          {
                            type: 'stock',
                            product: updatedProduct.name,
                            quantity: stock,
                          }
                        )
                      }

                      if (price !== currentProduct.price) {
                        notify(
                          `${updatedProduct.name} price updated`,
                          `Price changed from ${money(currentProduct.price, settings.currency)} to ${money(price, settings.currency)}.`,
                          true,
                          {
                            type: 'product',
                            product: updatedProduct.name,
                            currency: settings.currency,
                          }
                        )
                      }

                      setToast('Stock changes saved')
                    } catch (error) {
                      console.error('Failed to save stock changes:', error)
                      setToast(error instanceof Error ? error.message : 'Failed to save stock changes')
                      throw error
                    }
                  }}
                  onDelete={(id) => setDeleteProduct(products.find((p) => p.id === id) ?? null)}
                />
