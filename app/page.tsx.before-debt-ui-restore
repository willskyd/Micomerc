  const refreshProducts = async () => {
    const response = await fetch('/api/products', { cache: 'no-store' })
    const result: unknown = await response.json().catch(() => null)
    if (!response.ok || !isProductList(result)) throw new Error('Inventory could not be refreshed. Reload before another stock operation.')
    setProducts(result)
    setProductsError('')
    return result
  }

  useEffect(() => {
    try {
      const raw = localStorage.getItem('electric-house-state')
      const saved = raw ? JSON.parse(raw) : null
      if (saved && typeof saved === 'object') {
        if (Array.isArray(saved.products)) setProducts(saved.products)
        if (Array.isArray(saved.debts)) setDebts(saved.debts)
        // if (Array.isArray(saved.receipts)) setReceipts(saved.receipts)
        // if (saved.settings && typeof saved.settings === 'object') setSettings((current) => ({ ...current, ...saved.settings }))
        if (Array.isArray(saved.activities)) setActivities(saved.activities)
      }
    } catch {
      localStorage.removeItem('electric-house-state')
    } finally {
      hasLoadedState.current = true
      setHydrated(true)
    }
  }, [])

  useEffect(() => {
    if (!hydrated || !hasLoadedState.current) return
    localStorage.setItem('electric-house-state', 
      JSON.stringify({ products, debts, activities }))
  }, [hydrated, products, debts, activities])

 useEffect(() => {
  let cancelled = false

  async function loadProducts() {
    try {
      const response = await fetch('/api/products')
      if (!response.ok) throw new Error('Product inventory request failed')
      const data: unknown = await response.json()
      if (!isProductList(data)) throw new Error('Product inventory returned invalid data')
      if (cancelled) return
      setProducts(data)
      setProductsError('')
    } catch (error) {
      console.error('Failed to load products:', error)
      if (!cancelled) {
        setProductsError('Inventory could not be loaded. Reload the dashboard before scanning or checking out.')
      }
    } finally {
      if (!cancelled) setProductsLoading(false)
    }
  }

  async function loadOtherDashboardData() {
    try {
      const [debtsRes, receiptsRes, activitiesRes] = await Promise.all([
        fetch('/api/debts'),
        fetch('/api/receipts'),
        fetch('/api/activities'),
      ])

      if (!debtsRes.ok || !receiptsRes.ok || !activitiesRes.ok) {
        throw new Error('Dashboard data request failed')
      }

      const [debtsData, receiptsData, activitiesData] = await Promise.all([
        debtsRes.json(),
        receiptsRes.json(),
        activitiesRes.json(),
      ])
      if (cancelled) return

      setDebts(Array.isArray(debtsData) ? debtsData : [])
      setReceipts(Array.isArray(receiptsData) ? receiptsData : [])
      setActivities(Array.isArray(activitiesData) ? activitiesData : [])

      if (Array.isArray(activitiesData) && activitiesData.length > 0) {
        setSelectedInbox(activitiesData[0])
      }
    } catch (error) {
      console.error('Failed to load other dashboard data:', error)
    }
  }

  void loadProducts()
  void loadOtherDashboardData()
  return () => { cancelled = true }
}, [])

useEffect(() => {
