function Toolbar({ query, setQuery, statusFilter, setStatusFilter, options }: { query: string; setQuery: (s: string) => void; statusFilter: string; setStatusFilter: (s: string) => void; options: string[] }) {
  return <div className="toolbar"><div className="search"><Search /><input value={query} onChange={(e) => setQuery(e.target.value)} placeholder="Search products, customers..." /></div><div className="filter-select"><SlidersHorizontal /><select value={statusFilter} onChange={(e) => setStatusFilter(e.target.value)} aria-label="Filter"><option value="All">All filters</option>{options.filter((x) => x !== 'All').map((x) => <option key={x}>{x}</option>)}</select></div></div>
}

function ProductTable({
  products,
  onNotify,
  onSaveEdit,
  onDelete,
  lowStockThreshold,
}: {
  products: Product[]
  onNotify: (s: string) => void
  onSaveEdit: (
    id: number,
    updates: Partial<Pick<Product, 'name' | 'model' | 'barcode' | 'category' | 'stock' | 'price' | 'status'>>
  ) => Promise<void>
  onDelete: (id: number) => void
  lowStockThreshold: number
}) {
  const [openId, setOpenId] = useState<number | null>(null)
  const [draft, setDraft] = useState<Product | null>(null)
  const [saving, setSaving] = useState(false)

  const startEditing = (product: Product) => {
    setDraft({ ...product })
    setOpenId(null)
  }

  const updateDraft = (
    key: 'name' | 'model' | 'barcode' | 'category' | 'stock' | 'price' | 'status',
    value: string
  ) => {
    setDraft((current) => {
      if (!current) return current

      if (key === 'stock' || key === 'price') {
        const numberValue = Number(value)
        return {
          ...current,
          [key]: Number.isFinite(numberValue)
            ? Math.max(0, numberValue)
            : 0,
        }
      }

      return { ...current, [key]: value }
    })
  }

  const saveDraft = async () => {
    if (!draft || saving) return

    if (!draft.name.trim()) {
      onNotify('Product name cannot be empty')
      return
    }

    setSaving(true)
    try {
      await onSaveEdit(draft.id, {
        name: draft.name.trim(),
        model: draft.model.trim(),
        barcode: draft.barcode?.trim() ?? '',
        category: draft.category.trim(),
        stock: draft.stock,
        price: draft.price,
        status: draft.status === 'Discontinued' ? 'Discontinued' : 'Automatic',
      })
      setDraft(null)
    } catch {
      // Keep the draft open so the user can retry.
    } finally {
      setSaving(false)
    }
  }

  return (
    <div className="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Product</th>
            <th>Category</th>
            <th>In stock</th>
            <th>Unit price</th>
            <th>Status</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {products.map((product) => {
            const isEditing = draft?.id === product.id
            const row = isEditing && draft ? draft : product

            const status =
              row.status === 'Discontinued'
                ? 'Discontinued'
                : row.stock === 0
                  ? 'Out of stock'
                  : row.stock <= lowStockThreshold
                    ? 'Low stock'
                    : 'In stock'

            return (
              <tr key={product.id}>
                <td>
                  <div className="product-name">
                    <div className="product-thumb"><Package /></div>
                    {isEditing ? (
                      <div className="flex w-full flex-col gap-2">
                        <input
                          className="rounded-lg border border-slate-200 bg-white px-2 py-1 text-sm text-slate-900 dark:border-slate-600 dark:bg-slate-800 dark:text-white"
                          value={row.name}
                          onChange={(e) => updateDraft('name', e.target.value)}
                          aria-label={`Name for ${product.name}`}
                        />
                        <input
                          className="rounded-lg border border-slate-200 bg-white px-2 py-1 text-xs text-slate-900 dark:border-slate-600 dark:bg-slate-800 dark:text-white"
                          value={row.model}
                          onChange={(e) => updateDraft('model', e.target.value)}
                          aria-label={`Model for ${product.name}`}
                        />
                        <input
                          className="rounded-lg border border-slate-200 bg-white px-2 py-1 text-xs text-slate-900 dark:border-slate-600 dark:bg-slate-800 dark:text-white"
                          value={row.barcode ?? ''}
                          onChange={(e) => updateDraft('barcode', e.target.value)}
                          aria-label={`Barcode for ${product.name}`}
                          placeholder="Barcode (optional)"
                        />
                      </div>
                    ) : (
                      <div>
                        <b>{product.name}</b>
                        <span>{product.model || product.sku}</span>
                        {product.barcode && <span>Barcode: {product.barcode}</span>}
                      </div>
                    )}
                  </div>
                </td>

                <td>
                  {isEditing ? (
                    <input
                      className="table-number"
                      value={row.category}
                      onChange={(e) => updateDraft('category', e.target.value)}
                      aria-label={`Category for ${product.name}`}
                    />
                  ) : product.category}
                </td>

                <td>
                  {isEditing ? (
                    <input
                      className="table-number"
                      type="number"
                      min="0"
                      step="1"
                      value={row.stock}
                      onChange={(e) => updateDraft('stock', e.target.value)}
                      aria-label={`Stock for ${product.name}`}
                    />
                  ) : product.stock}
                  {' '}units
                </td>

                <td>
                  {isEditing ? (
                    <input
                      className="table-number price"
                      type="number"
                      min="0"
                      step="0.01"
                      value={row.price}
                      onChange={(e) => updateDraft('price', e.target.value)}
                      aria-label={`Price for ${product.name}`}
                    />
                  ) : product.price}
                </td>

                <td>
                  {isEditing ? (
                    <select
                      className="status-control"
                      value={row.status === 'Discontinued' ? 'Discontinued' : 'Automatic'}
                      onChange={(e) => updateDraft('status', e.target.value)}
                      aria-label={`Availability for ${product.name}`}
                    >
                      <option value="Automatic">Automatic</option>
                      <option value="Discontinued">Discontinued</option>
                    </select>
                  ) : (
                    <span className="status-pill">{status}</span>
                  )}
                </td>

                <td className="row-actions">
                  {isEditing ? (
                    <div className="flex flex-wrap gap-2">
                      <button
                        className="primary-button"
                        disabled={saving}
                        onClick={saveDraft}
                      >
                        {saving ? 'Saving...' : 'Save Changes'}
                      </button>
                      <button
                        className="secondary-button"
                        disabled={saving}
                        onClick={() => setDraft(null)}
                      >
                        Cancel
                      </button>
                    </div>
                  ) : (
                    <>
                      <button
                        className="more-button"
                        onClick={() =>
                          setOpenId(openId === product.id ? null : product.id)
                        }
                        aria-label={`More actions for ${product.name}`}
                        aria-expanded={openId === product.id}
                      >
                        <MoreHorizontal />
                      </button>

                      {openId === product.id && (
                        <div className="stock-menu">
                          <button
                            onClick={() => {
                              onNotify(`${product.name} has ${product.stock} units available`)
                              setOpenId(null)
                            }}
                          >
                            View stock details
                          </button>
                          <button onClick={() => startEditing(product)}>
                            Edit Stock
                          </button>
                          <button
                            onClick={() => {
                              setOpenId(null)
                              onDelete(product.id)
                            }}
                          >
                            Delete stock
                          </button>
                        </div>
                      )}
                    </>
                  )}
                </td>
              </tr>
            )
          })}
        </tbody>
      </table>

      {!products.length && (
        <div className="empty">
          <Package />
          <b>No products found</b>
          <span>Adjust your search or add a new item.</span>
        </div>
      )}
    </div>
  )
}

function Receipts({
  receipts,
  onEdit,
  onDelete,
}: {
  receipts: Receipt[]
  onEdit: (
    id: number,
    updates: Partial<Pick<Receipt, 'name' | 'model' | 'quantity' | 'invoice'>>
  ) => Promise<void>
  onDelete: (id: number) => void
}) {
  const [editing, setEditing] = useState<Record<number, Receipt>>({})
  const [saving, setSaving] = useState<number | null>(null)

  const startEditing = (receipt: Receipt) => {
    setEditing((current) => ({
      ...current,
      [receipt.id]: { ...receipt },
    }))
  }

  const updateEditing = (
    id: number,
    key: 'name' | 'model' | 'quantity' | 'invoice',
    value: string
  ) => {
    setEditing((current) => ({
      ...current,
      [id]: {
        ...current[id],
        [key]:
          key === 'quantity'
            ? Number(value) || 0
            : value,
      },
    }))
  }

  const saveEditing = async (id: number) => {
    const draft = editing[id]

    if (!draft) return

    try {
      setSaving(id)

      await onEdit(id, {
        name: draft.name,
        model: draft.model,
        quantity: draft.quantity,
        invoice: draft.invoice,
      })

      setEditing((current) => {
        const next = { ...current }
        delete next[id]
        return next
      })
    } finally {
      setSaving(null)
    }
  }

  return (
    <div className="receipt-list">
      {receipts.map((r) => {
        const draft = editing[r.id]
        const current = draft ?? r

        return (
          <details className="receipt-row" key={r.id}>
            <summary>
              <div className="receipt-icon">
                <ArrowDownLeft />
              </div>

              <div className="receipt-info">
                <b>{r.name}</b>
                <span>
                  Invoice #{r.invoice} · {daysAgo(r.date)}
                </span>
              </div>

              <strong>+{r.quantity} items</strong>

              <span className="status-pill success">
                Completed
              </span>

              <ChevronDown />
            </summary>

            <div className="receipt-details">
              <label>
                Stock name
                <input
                  value={current.name}
                  onFocus={() => startEditing(r)}
                  onChange={(e) =>
                    updateEditing(
                      r.id,
                      'name',
                      e.target.value
                    )
                  }
                />
              </label>

              <label>
                Model number
                <input
                  value={current.model}
                  onFocus={() => startEditing(r)}
                  onChange={(e) =>
                    updateEditing(
                      r.id,
                      'model',
                      e.target.value
                    )
                  }
                />
              </label>

              <label>
                Quantity
                <input
                  type="number"
                  min="0"
                  value={current.quantity}
                  onFocus={() => startEditing(r)}
                  onChange={(e) =>
                    updateEditing(
                      r.id,
                      'quantity',
                      e.target.value
                    )
                  }
                />
              </label>

              <label>
                Invoice
                <input
                  value={current.invoice}
                  onFocus={() => startEditing(r)}
                  onChange={(e) =>
                    updateEditing(
                      r.id,
                      'invoice',
                      e.target.value
                    )
                  }
                />
              </label>

              <div className="flex gap-2">
                {draft && (
                  <button
                    type="button"
                    className="primary-button"
                    disabled={saving === r.id}
                    onClick={() => saveEditing(r.id)}
                  >
                    {saving === r.id
                      ? 'Saving...'
                      : 'Save changes'}
                  </button>
                )}

                <button
                  type="button"
                  className="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-slate-100 px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-200"
                  onClick={() => onDelete(r.id)}
                >
                  Delete stock
                </button>
              </div>
            </div>
          </details>
        )
      })}
    </div>
  )
}

function DebtTable({ debts, paid, onOpen, currency }: { debts: Debt[]; paid: boolean; onOpen: (d: Debt) => void; currency: string }) {
  return <div className="table-wrap"><table><thead><tr><th>Customer</th><th>Invoice</th><th>Amount</th><th>Remaining</th>
  <th>{paid ? 'Paid at' : 'Due'}</th></tr></thead><tbody>{debts.map((d) => {
    const paidAmount = d.payments.reduce((a, p) => a + p.amount, 0)
    return <tr key={d.id} onClick={() => onOpen(d)} className="clickable-row"><td><div className="customer">
      <div className="avatar customer-avatar">{d.customer.slice(0, 2).toUpperCase()}</div><b>{d.customer}</b></div></td>
      <td>{d.invoice}</td><td><b>{money(d.amount, currency )}</b></td>
      <td><b>{money(Math.max(0, d.amount - paidAmount), currency )}</b>
      <span className="progress"><i style={{ width: `${Math.min(100, (paidAmount / d.amount) * 100)}%` }} /></span></td>
      <td><span className="status-pill success">{paid ? d.paidAt : 'Open · ' + d.due}</span></td></tr>
  })}</tbody></table>{!debts.length && <div className="empty"><CircleDollarSign />
  <b>{paid ? 'No paid debts' : 'No outstanding debts'}</b>
  <span>{paid ? 'Completed payments will appear here.' : 'All customer balances are clear.'}</span></div>}</div>
}

function DebtDetail({
  debt,
  readOnly,
  onClose,
  onSave,
}: {
  debt: Debt
  readOnly: boolean
  onClose: () => void
  onSave: (draft: Debt, fullyPaid: boolean) => Promise<Debt>
}) {
  const [draft, setDraft] = useState<Debt>(JSON.parse(JSON.stringify(debt)) as Debt)
  const [saving, setSaving] = useState(false)
  const [error, setError] = useState('')
  const isSavedDebt = Boolean(debt.id)
  const originalPaymentIds = useMemo(() => new Set((debt.payments ?? []).map((payment) => payment.id)), [debt.payments])
  const paidTotal = (draft.payments ?? []).reduce((total, payment) => total + Math.max(0, Number(payment.amount) || 0), 0)
  const balance = Math.max(0, (Number(draft.amount) || 0) - paidTotal)

  const updateItem = (index: number, key: 'name' | 'price', value: string | number) => {
    setDraft((current) => {
      const items = current.items.map((item, row) => row === index ? {
        ...item,
        [key]: key === 'price' ? Math.max(0, Number(value) || 0) : value,
      } : item)

      const nextAmount = items.reduce((sum, item) => sum + Math.max(0, Number(item.price) || 0), 0)

      return {
        ...current,
        items,
        amount: nextAmount,
      }
    })
  }

  const addItem = () => {
    setDraft((current) => ({
      ...current,
      items: [...current.items, { name: '', price: 0, date: now() }],
    }))
  }

  const saveDraft = async () => {
    if (readOnly || saving) return

    const normalizedDraft: Debt = {
      ...draft,
      customer: draft.customer.trim(),
      items: (draft.items ?? []).map((item) => ({
        ...item,
        name: String(item.name ?? '').trim(),
        price: Math.max(0, Number(item.price) || 0),
        date: item.date ?? now(),
      })),
      amount: Math.max(0, Number(draft.amount) || 0),
      payments: (draft.payments ?? []).map((payment) => ({
        ...payment,
        amount: Math.max(0, Number(payment.amount) || 0),
      })),
    }

    setSaving(true)
    setError('')

    try {
      await onSave(normalizedDraft, balance <= 0)
    } catch (saveError) {
      setError(saveError instanceof Error ? saveError.message : 'Debt could not be saved')
    } finally {
      setSaving(false)
    }
  }

  return (
    <div className="modal-backdrop">
      <div className="modal wide debt-detail-modal">
        <div className="modal-header">
          <div>
            <div className="eyebrow">Debt detail</div>
            <h2>{draft.customer}</h2>
            <p>{draft.invoice} · Created {draft.createdAt}</p>
          </div>
          <button type="button" className="icon-button" onClick={onClose} aria-label="Close debt details">
            <X />
          </button>
        </div>

        <div className="debt-detail-body modal-scroll-body">
          <div className="detail-grid">
            <label>
              Customer name
              <input disabled={readOnly || isSavedDebt} value={draft.customer} onChange={(event) => setDraft({ ...draft, customer: event.target.value })} />
            </label>
            <label>
              Original debt amount
              <input type="number" disabled={readOnly || isSavedDebt} value={draft.amount} onChange={(event) => setDraft({ ...draft, amount: Number(event.target.value) })} />
            </label>
          </div>

          <h3>Items bought</h3>
          <div className="editable-list">
            {draft.items.map((item, index) => {
              const isExistingItem = index < debt.items.length
              return <div className="editable-row" key={`debt-item-${index}`}>
                <input type="text" disabled={readOnly || (isExistingItem && isSavedDebt)} value={item.name ?? ''} onChange={(event) => updateItem(index, 'name', event.target.value)} placeholder="Item name" />
                <input type="number" disabled={readOnly || (isExistingItem && isSavedDebt)} value={item.price} onChange={(event) => updateItem(index, 'price', event.target.value)} placeholder="0" />
                {item.date && <span className="item-date">{item.date}</span>}
              </div>
            })}
            {!readOnly && <button type="button" className="secondary-button" onClick={addItem}><Plus />Add item</button>}
          </div>

          <h3>Part payments</h3>
          <div className="payment-list">
            {draft.payments.map((payment, index) => {
              const isLocked = readOnly || originalPaymentIds.has(payment.id)
              return <div className="editable-row" key={String(payment.id ?? `${payment.date}-${index}`)}>
                <input type="number" disabled={isLocked} value={payment.amount} onChange={(event) => setDraft((current) => ({ ...current, payments: current.payments.map((item, row) => row === index ? { ...item, amount: Number(event.target.value) } : item) }))} />
                <span>{payment.date}</span>
              </div>
            })}
            {!readOnly && <button type="button" className="secondary-button" onClick={() => setDraft((current) => ({ ...current, payments: [...current.payments, { id: Date.now(), amount: 0, date: now() }] }))}><Plus />Add payment</button>}
          </div>
        </div>

        <div className="summary-row">
          <div>
            <span>{readOnly ? 'Paid in full' : 'Balance'}</span>
            <strong>{readOnly ? money(draft.amount) : money(balance)}</strong>
          </div>

          {!readOnly && (
            <>
              {error && <small className="field-error">{error}</small>}
              <button
                className="primary-button"
                onClick={() => void saveDraft()}
                disabled={saving}
              >
                {saving ? 'Saving…' : balance <= 0 ? 'Mark as paid' : 'Save changes'}
              </button>
            </>
          )}
        </div>
      </div>
    </div>
  )
}


type DebtDraftLine = { productId: string; quantity: string; amount: string }

function DebtComposer({ products, productsLoading, productsError, currency, onClose, onSubmit }: {
  products: Product[]
  productsLoading: boolean
  productsError: string
  currency: string
  onClose: () => void
  onSubmit: (event: React.FormEvent<HTMLFormElement>) => void
}) {
  const [customer, setCustomer] = useState('')
  const [lines, setLines] = useState<DebtDraftLine[]>([{ productId: '', quantity: '', amount: '' }])
  const idempotencyRef = useRef<HTMLInputElement>(null)
  const sellableProducts = products.filter((product) => product.status.toLowerCase() !== 'discontinued')
  const requestedByProduct = new Map<number, number>()
  for (const line of lines) {
    const productId = Number(line.productId)
    const quantity = Number(line.quantity)
    if (Number.isSafeInteger(productId) && Number.isFinite(quantity) && quantity > 0) {
      requestedByProduct.set(productId, (requestedByProduct.get(productId) ?? 0) + quantity)
    }
  }
  const totalMinor = lines.reduce((total, line) => {
    const product = products.find((item) => String(item.id) === line.productId)
    const quantity = Number(line.quantity)
    const amount = Number(line.amount)
    const resolvedAmount = Number.isFinite(amount) && amount >= 0 ? amount : (product && Number.isFinite(quantity) && quantity > 0 ? product.price * quantity : 0)
    if (!product || !Number.isFinite(quantity) || quantity <= 0 || !Number.isFinite(resolvedAmount) || resolvedAmount < 0) return total
    return total + Math.round(resolvedAmount * 100)
  }, 0)
  const lineError = lines.some((line) => {
    const product = products.find((item) => String(item.id) === line.productId)
    const quantity = Number(line.quantity)
    const amount = Number(line.amount)
    if (!product || !Number.isFinite(quantity) || quantity <= 0 || quantity > 1_000_000 || Math.abs(quantity * 1000 - Math.round(quantity * 1000)) > 0.000001) return true
    if (!Number.isFinite(amount) || amount <= 0 || amount > 1_000_000_000) return true
    return (requestedByProduct.get(product.id) ?? 0) > product.stock + 0.000001
  })
  const canSubmit = customer.trim().length > 0 && lines.length > 0 && !lineError && totalMinor > 0 && !productsLoading && !productsError
  const resetRequestKey = () => { if (idempotencyRef.current) idempotencyRef.current.value = '' }
  const updateLine = (index: number, key: keyof DebtDraftLine, value: string) => {
    resetRequestKey()
    setLines((current) => current.map((line, row) => {
      if (row !== index) return line
      const nextLine = { ...line, [key]: value }
      if ((key === 'productId' || key === 'quantity') && (!nextLine.amount || Number(nextLine.amount) === 0)) {
        const product = products.find((item) => String(item.id) === nextLine.productId)
        const quantity = Number(nextLine.quantity)
        if (product && Number.isFinite(quantity) && quantity > 0) {
          nextLine.amount = String(product.price * quantity)
        }
      }
      return nextLine
    }))
  }
  const submit = (event: React.FormEvent<HTMLFormElement>) => {
    if (!canSubmit) { event.preventDefault(); return }
    if (idempotencyRef.current && !idempotencyRef.current.value) idempotencyRef.current.value = window.crypto.randomUUID()
    onSubmit(event)
  }

  return <div className="modal-backdrop" onMouseDown={(event) => event.currentTarget === event.target && onClose()}>
    <div className="modal wide debt-create-modal">
      <div className="modal-header"><div><div className="eyebrow">Customer account</div><h2>Add customer debt</h2><p>Choose catalog products. Their saved prices set the debt total and stock is deducted when saved.</p></div><button type="button" className="icon-button" onClick={onClose} aria-label="Close debt form"><X /></button></div>
      <form onSubmit={submit} noValidate>
        <label>Customer name<input name="customer" value={customer} onChange={(event) => { setCustomer(event.target.value); resetRequestKey() }} maxLength={120} required placeholder="e.g. Harbor Market" /></label>
        <input type="hidden" name="lines" value={JSON.stringify(lines.map((line) => ({ productId: Number(line.productId), quantity: Number(line.quantity), amount: Number(line.amount) || 0 })))} />
        <input type="hidden" name="idempotencyKey" ref={idempotencyRef} defaultValue="" />
        <section className="debt-composer-section" aria-labelledby="debt-items-title">
          <div className="debt-composer-heading"><span><b id="debt-items-title">Items bought</b><small>Search stock products, enter the quantity, and add the amount for each debt item.</small></span><button type="button" className="secondary-button" onClick={() => { resetRequestKey(); setLines((current) => current.length < 30 ? [...current, { productId: '', quantity: '', amount: '' }] : current) }} disabled={lines.length >= 30}><Plus size={15} /> Add product</button></div>
          {lines.map((line, index) => {
            const product = products.find((item) => String(item.id) === line.productId)
            const quantity = Number(line.quantity)
            const lineAmount = Number(line.amount)
            const lineMinor = product && Number.isFinite(quantity) && quantity > 0 ? Math.round(Math.round(product.price * 100) * quantity) : null
            const remaining = product ? product.stock - (requestedByProduct.get(product.id) ?? 0) : null
            return <div className="debt-composer-line" key={`debt-line-${index}`}>
              <label>Product<SearchableProductSelect products={sellableProducts} value={line.productId} onChange={(productId) => updateLine(index, 'productId', productId)} disabled={productsLoading || !!productsError} label={`Debt product row ${index + 1}`} /></label>
              <label>Quantity<input type="number" min="0.001" max={product?.stock} step="0.001" value={line.quantity} onChange={(event) => updateLine(index, 'quantity', event.target.value)} placeholder="0" aria-label={`Quantity for debt product row ${index + 1}`} /></label>
              <label>Amount<input type="number" min="0" step="0.01" value={line.amount} onChange={(event) => updateLine(index, 'amount', event.target.value)} placeholder="0.00" aria-label={`Amount for debt product row ${index + 1}`} /></label>
              <label>Unit price<input readOnly value={product ? money(product.price, currency) : '—'} aria-label={`Catalog unit price for debt product row ${index + 1}`} /></label>
              <label>Line total<input readOnly value={lineMinor === null ? '—' : money(lineMinor / 100, currency)} aria-label={`Debt line total for row ${index + 1}`} /></label>
              {lines.length > 1 && <button type="button" className="prototype-remove-line" aria-label={`Remove debt product row ${index + 1}`} onClick={() => { resetRequestKey(); setLines((current) => current.filter((_, row) => row !== index)) }}><X size={17} /></button>}
              <p className={`debt-line-summary${remaining !== null && remaining < -0.000001 ? ' is-error' : ''}`}>{product ? `Available stock: ${product.stock.toLocaleString()} · requested across debt: ${requestedByProduct.get(product.id)?.toLocaleString() ?? '0'} · remaining: ${remaining?.toLocaleString()}` : 'Select a stock product to see its catalog price.'}{Number.isFinite(lineAmount) && lineAmount > 0 ? ` · line amount: ${money(lineAmount, currency)}` : ''}</p>
            </div>
          })}
          {productsLoading && <p className="prototype-inline-note" role="status">Loading stock products…</p>}
          {productsError && <p className="prototype-feedback error" role="alert">{productsError}</p>}
          {!productsLoading && !productsError && sellableProducts.length === 0 && <p className="prototype-inline-note">No products are available for a debt entry.</p>}
        </section>
        <div className="debt-review-summary"><b>Debt amount</b><span>Calculated from quantity × amount or saved catalog price</span><strong>{money(totalMinor / 100, currency)}</strong><small>Saving this debt records the product quantities and deducts them from stock.</small></div>
        {lineError && <p className="prototype-feedback error" role="alert">Select a product and valid quantity and amount for every row. Quantities must be in stock and use no more than three decimal places.</p>}
        <div className="modal-actions"><button type="button" className="secondary-button" onClick={onClose}>Cancel</button><button className="primary-button" type="submit" disabled={!canSubmit}><Check />Save debt</button></div>
      </form>
    </div>
  </div>
}

function RecordModal({ type, onClose, onSubmit, products, productsLoading, productsError, currency }: { type: 'product' | 'debt' | 'receipt' | 'login' | 'detail'; onClose: () => void; onSubmit: (e: React.FormEvent<HTMLFormElement>) => void; products: Product[]; productsLoading: boolean; productsError: string; currency: string }) {
  if (type === 'debt') return <DebtComposer products={products} productsLoading={productsLoading} productsError={productsError} currency={currency} onClose={onClose} onSubmit={onSubmit} />
  return <div className="modal-backdrop" onMouseDown={(e) => e.currentTarget === e.target && onClose()}>
    <div className="modal">
      <div className="modal-header"><div><div className="eyebrow">Workspace action</div><h2>{type === 'product' ? 'Add new product' : type === 'receipt' ? 'Record stock receipt' : 'Workspace action'}</h2></div><button className="icon-button" onClick={onClose}><X /></button></div>
      <form onSubmit={onSubmit}>
        <label>Name or reference<input name="name" required placeholder="e.g. Premium Rice 25kg" /></label>
        {type === 'product' && <div className="form-row">
          <label>Category<select name="category" defaultValue="Groceries"><option>Groceries</option><option>Beverages</option><option>Household</option></select></label>
          <label>Model number<input name="model" placeholder="e.g. MEC-RIC-2501" /></label>
          <label>Barcode (optional)<input name="barcode" type="text" inputMode="text" autoComplete="off" maxLength={128} placeholder="Keep leading zeroes" /></label>
          <label>Price<input name="price" type="number" min="0" step="0.01" required /></label>
          <label>Quantity<input name="stock" type="number" min="0" required /></label>
        </div>}
        {type === 'receipt' && <><label>Model number<input name="model" required placeholder="e.g. MEC-RIC-2501" /></label><div className="form-row"><label>Quantity<input name="quantity" type="number" min="0" required /></label><label>Invoice<input name="invoice" required placeholder="e.g. INV-STK-021" /></label></div></>}
        <div className="modal-actions"><button type="button" className="secondary-button" onClick={onClose}>Cancel</button><button className="primary-button" type="submit"><Check />Save record</button></div>
      </form>
    </div>
  </div>
}

