      const response = await fetch(`/api/receipts/${id}`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(updates),
      })

      if (!response.ok) {
        throw new Error('Failed to update stock')
      }

      const updatedReceipt = await response.json()

      setReceipts((items) =>
        items.map((item) =>
