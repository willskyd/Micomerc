          <div className="pos-sales-date-field">
            <button
              type="button"
              className="pos-sales-date-trigger"
              aria-label="Choose summary end date"
              aria-expanded={openCalendar === 'to'}
              onClick={() => setOpenCalendar(openCalendar === 'to' ? null : 'to')}
